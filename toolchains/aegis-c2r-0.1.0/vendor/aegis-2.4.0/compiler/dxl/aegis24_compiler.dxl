    if id==11 { return len==5&&s[start]==105&&s[start+1]==115&&s[start+2]==101&&s[start+3]==114&&s[start+4]==114; }
    if id==12 { return len==4&&s[start]==98&&s[start+1]==108&&s[start+2]==101&&s[start+3]==110; }
