                else if len>7&&src[start]==98&&src[start+1]==117&&src[start+2]==102&&src[start+3]==102&&src[start+4]==101&&src[start+5]==114&&src[start+6]==58&&src[start+7]!=58 {
                    let hn:i64=len-7;let bn:i64=hn/2;if hn<=0||hn%2!=0||heap+bn>MAX_HEAP{ok=false;error=90;}else{let j:i64=0;let valid:bool=true;while j<bn&&valid{let hi:i64=hex(src[start+7+j*2]);let lo:i64=hex(src[start+8+j*2]);if hi<0||lo<0{valid=false;}else{out[pos+5+j]=hi*16+lo;}j=j+1;}if !valid{ok=false;error=92;}else{out[pos]=OP_BUFFER;store32(out,pos+1,bn);pos=pos+5+bn;heap=heap+bn;depth=depth+1;steps=steps+1;}}
                } else if len>5&&src[start]==116&&src[start+1]==101&&src[start+2]==120&&src[start+3]==116&&src[start+4]==58&&src[start+5]!=58 {
                    let hn:i64=len-5;let bn:i64=hn/2;if hn<=0||hn%2!=0||heap+bn>MAX_HEAP{ok=false;error=90;}else{let j:i64=0;let valid:bool=true;while j<bn&&valid{let hi:i64=hex(src[start+5+j*2]);let lo:i64=hex(src[start+6+j*2]);if hi<0||lo<0{valid=false;}else{out[pos+5+j]=hi*16+lo;}j=j+1;}if !valid||!utf8_valid(out,pos+5,bn){ok=false;error=149;}else{out[pos]=OP_TEXT;store32(out,pos+1,bn);pos=pos+5+bn;heap=heap+bn;depth=depth+1;steps=steps+1;}}
                } else if len>6&&src[start]==101&&src[start+1]==114&&src[start+2]==114&&src[start+3]==111&&src[start+4]==114&&src[start+5]==58&&src[start+6]!=58 {
                    let ec:Parse=parse_u16(src,start+6,len-6);if !ec.ok{ok=false;error=153;}else{out[pos]=OP_ERROR;store32(out,pos+1,ec.value);pos=pos+5;depth=depth+1;steps=steps+1;}
                } else if len>2&&src[start]==116&&src[start+1]==58 {
                    let count:i64=len-2;if count<=0||count>40{ok=false;error=150;}else{let packed:i64=(count+4)/5;out[pos]=OP_TRIT;out[pos+1]=count;let q:i64=0;while q<packed{out[pos+2+q]=0;q=q+1;}let j:i64=0;let valid:bool=true;while j<count&&valid{let d:i64=trit_digit(src[start+2+j]);if d<0{valid=false;}else{let mul:i64=1;let k:i64=0;while k<j%5{mul=mul*3;k=k+1;}out[pos+2+j/5]=out[pos+2+j/5]+d*mul;}j=j+1;}if !valid{ok=false;error=151;}else{pos=pos+2+packed;depth=depth+1;steps=steps+1;}}
                } else {
                    let op:i64=-1;
                    if is_word(src,start,len,1){op=OP_BFREEZE;}else if is_word(src,start,len,2){op=OP_BSLICE;}else if is_word(src,start,len,3){op=OP_BWRITE;}else if is_word(src,start,len,4){op=OP_FREE;}else if is_word(src,start,len,5){op=OP_TWRITE;}else if is_word(src,start,len,6){op=OP_ERRCODE;}else if is_word(src,start,len,7){op=OP_PRINT;}else if is_word(src,start,len,8){op=OP_TNOT;}else if is_word(src,start,len,9){op=OP_UTF8;}else if is_word(src,start,len,10){op=OP_TRY;}else if is_word(src,start,len,11){op=OP_ISERR;}else if is_word(src,start,len,12){op=OP_BLEN;}else if is_word(src,start,len,13){op=OP_BGET;}else if is_word(src,start,len,14){op=OP_BSET;}else if is_word(src,start,len,15){op=OP_BWRITE;}else if is_word(src,start,len,16){op=OP_HALT;}else if is_word(src,start,len,17){op=OP_ISERR;}
                    else if len>10&&src[start]==110&&src[start+1]==97&&src[start+2]==109&&src[start+3]==101&&src[start+4]==115&&src[start+5]==112&&src[start+6]==97&&src[start+7]==99&&src[start+8]==101&&src[start+9]==58 { op=-2; }
                    else if len==12&&src[start]==101&&src[start+1]==110&&src[start+2]==100&&src[start+3]==110&&src[start+4]==97&&src[start+5]==109&&src[start+6]==101&&src[start+7]==115&&src[start+8]==112&&src[start+9]==97&&src[start+10]==99&&src[start+11]==101 {op=-2;}
                    if op==-2 { }
                    else if op<0{ok=false;error=87;}
                    else {out[pos]=op;pos=pos+1;steps=steps+1;if op==OP_BSLICE{depth=depth-2;}else if op==OP_PRINT||op==OP_FREE{depth=depth-1;}else if op==OP_BLEN{depth=depth+1;}if op==OP_PRINT{caps=caps_add(caps,CAP_PRINT);}if op==OP_BWRITE||op==OP_TWRITE{caps=caps_add(caps,CAP_BYTES);}if op==OP_HALT{halted=true;}if depth<0||depth>MAX_STACK{ok=false;error=34;}}
                }
                if depth>maxd{maxd=depth;}
            }
        }
    }
    if ok&&!halted{out[pos]=OP_HALT;pos=pos+1;steps=steps+1;}
    if ok {store32(out,8,pos-H);store32(out,12,adler(out,H,pos-H));store32(out,16,caps);store32(out,20,maxd);store32(out,24,steps);store32(out,28,heap);store32(out,32,adler(src,0,array_len(src)));return ok_i64(pos);}
    return err_i64(as(i32,error));
}
fn main()->i32 {
    if arg_count()!=3{return as(i32,2);}let src_owner:array_i64=read_arg_bytes(1);let src:slice_i64=slice(src_owner,0,array_len(src_owner));let out_owner:array_i64=array_new(array_len(src)*10+256,0);let out:slice_i64=slice(out_owner,0,array_len(out_owner));let r:result_i64=compile(src,out);let rc:i32=as(i32,0);if is_err(r){print_i32(error_code(r));rc=as(i32,1);}else{let n:i64=unwrap_i64(r);let b:slice_i64=slice(out_owner,0,n);let w:result_i64=write_arg_bytes(2,b);if is_err(w){rc=as(i32,1);}}array_free(out_owner);array_free(src_owner);return rc;
}
