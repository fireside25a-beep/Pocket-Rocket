fn compile(src:slice_i64,out:slice_i64)->result_i64 {
    let z:i64=0;while z<H{out[z]=0;z=z+1;}out[0]=68;out[1]=88;out[2]=66;out[3]=51;out[4]=3;store32(out,36,POLICY);
    let i:i64=0;let pos:i64=H;let depth:i64=0;let maxd:i64=0;let steps:i64=0;let caps:i64=0;let heap:i64=0;let ok:bool=true;let error:i64=0;let halted:bool=false;
    while i<array_len(src)&&ok {
