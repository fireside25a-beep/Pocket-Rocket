// Aegis DXB3 definitions and deterministic helpers.
const A_HEADER: i64 = 40;
const A_MAX_STACK: i64 = 4096;
const A_MAX_STEPS: i64 = 10000000;
const A_MAX_HEAP: i64 = 65536;
const A_MAX_OBJECTS: i64 = 256;
const A_MAX_NESTING: i64 = 64;
const A_POLICY: i64 = 1;
const A_CAP_PRINT_I64: i64 = 1;
const A_CAP_WRITE_BYTES: i64 = 2;
const A_CAP_PRINT: i64 = A_CAP_PRINT_I64;
const A_CAP_ALL: i64 = 3;

const A_HALT: i64 = 0;
const A_PUSH: i64 = 1;
const A_ADD: i64 = 2;
const A_SUB: i64 = 3;
const A_MUL: i64 = 4;
const A_DIV: i64 = 5;
const A_MOD: i64 = 6;
const A_DUP: i64 = 7;
const A_DROP: i64 = 8;
const A_SWAP: i64 = 9;
const A_PRINT: i64 = 10;
const A_NEG: i64 = 11;
const A_EQ: i64 = 12;
const A_LT: i64 = 13;
const A_LE: i64 = 14;
const A_ALLOC: i64 = 15;
const A_MGET: i64 = 16;
const A_MSET: i64 = 17;
const A_FREE: i64 = 18;
const A_REPEAT: i64 = 19;
const A_IFZERO: i64 = 20;
const A_ASSERT: i64 = 21;
const A_BYTES: i64 = 22;
const A_BLEN: i64 = 23;
const A_BGET: i64 = 24;
const A_BSET: i64 = 25;
const A_BWRITE: i64 = 26;

struct AParseInt {
    ok: bool,
    value: i64,
}

struct AAnalysis {
    ok: bool,
    error: i64,
    depth: i64,
    max_depth: i64,
    steps: i64,
    caps: i64,
    halted: bool,
}


struct AHandle {
    ok: bool,
    error: i64,
    slot: i64,
}

struct AExec {
    ok: bool,
    error: i64,
    sp: i64,
    bump: i64,
    live: i64,
    steps: i64,
    trace: i64,
    halted: bool,
}

fn a_space(c: i64) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

fn a_digit(c: i64) -> bool {
    return c >= 48 && c <= 57;
}

fn a_hex_nibble(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48; }
    if c >= 65 && c <= 70 { return c - 55; }
    if c >= 97 && c <= 102 { return c - 87; }
    return -1;
}

fn a_caps_add(current: i64, cap: i64) -> i64 {
    if current == 0 { return cap; }
    if cap == 0 || current == cap { return current; }
    return A_CAP_ALL;
}

fn a_caps_allowed(required: i64, allowed: i64) -> bool {
    if required == 0 { return true; }
    if required == A_CAP_PRINT_I64 { return allowed == A_CAP_PRINT_I64 || allowed == A_CAP_ALL; }
    if required == A_CAP_WRITE_BYTES { return allowed == A_CAP_WRITE_BYTES || allowed == A_CAP_ALL; }
    return required == A_CAP_ALL && allowed == A_CAP_ALL;
}

fn a_bytes_prefix(src: slice_i64, start: i64, length: i64, upper: bool) -> bool {
    if length <= 6 { return false; }
    if upper {
        return src[start] == 66 && src[start+1] == 89 && src[start+2] == 84 && src[start+3] == 69 && src[start+4] == 83 && src[start+5] == 58;
    }
    return src[start] == 98 && src[start+1] == 121 && src[start+2] == 116 && src[start+3] == 101 && src[start+4] == 115 && src[start+5] == 58;
}

fn a_parse_i32(src: slice_i64, start: i64, length: i64) -> AParseInt {
    if length <= 0 { return AParseInt{ok: false, value: 0}; }
    let i: i64 = 0;
    let neg: bool = false;
    if src[start] == 45 && length > 1 { neg = true; i = 1; }
    let value: i64 = 0;
    let valid: bool = true;
    while i < length && valid {
        let c: i64 = src[start + i];
        if !a_digit(c) { valid = false; }
        else {
            value = value * 10 + (c - 48);
            if value > 2147483648 { valid = false; }
        }
        i = i + 1;
    }
    if !valid { return AParseInt{ok: false, value: 0}; }
    if neg { value = 0 - value; }
    if value < -2147483648 || value > 2147483647 { return AParseInt{ok: false, value: 0}; }
    return AParseInt{ok: true, value: value};
}

fn a_parse_u32(src: slice_i64, start: i64, length: i64, limit: i64) -> AParseInt {
    if length <= 0 { return AParseInt{ok: false, value: 0}; }
    let i: i64 = 0;
    let value: i64 = 0;
    let valid: bool = true;
    while i < length && valid {
        let c: i64 = src[start + i];
        if !a_digit(c) { valid = false; }
        else {
            value = value * 10 + (c - 48);
            if value > limit { valid = false; }
        }
        i = i + 1;
    }
    return AParseInt{ok: valid, value: value};
}

fn a_eq(src: slice_i64, start: i64, length: i64, code: i64) -> bool {
    if code == 1 { return length == 3 && src[start] == 100 && src[start+1] == 117 && src[start+2] == 112; }
    if code == 2 { return length == 4 && src[start] == 100 && src[start+1] == 114 && src[start+2] == 111 && src[start+3] == 112; }
    if code == 3 { return length == 4 && src[start] == 115 && src[start+1] == 119 && src[start+2] == 97 && src[start+3] == 112; }
    if code == 4 { return length == 5 && src[start] == 112 && src[start+1] == 114 && src[start+2] == 105 && src[start+3] == 110 && src[start+4] == 116; }
    if code == 5 { return length == 3 && src[start] == 110 && src[start+1] == 101 && src[start+2] == 103; }
    if code == 6 { return length == 4 && src[start] == 104 && src[start+1] == 97 && src[start+2] == 108 && src[start+3] == 116; }
    if code == 7 { return length == 2 && src[start] == 101 && src[start+1] == 113; }
    if code == 8 { return length == 2 && src[start] == 108 && src[start+1] == 116; }
    if code == 9 { return length == 2 && src[start] == 108 && src[start+1] == 101; }
    if code == 10 { return length == 5 && src[start] == 97 && src[start+1] == 108 && src[start+2] == 108 && src[start+3] == 111 && src[start+4] == 99; }
    if code == 11 { return length == 4 && src[start] == 109 && src[start+1] == 103 && src[start+2] == 101 && src[start+3] == 116; }
    if code == 12 { return length == 4 && src[start] == 109 && src[start+1] == 115 && src[start+2] == 101 && src[start+3] == 116; }
    if code == 13 { return length == 4 && src[start] == 102 && src[start+1] == 114 && src[start+2] == 101 && src[start+3] == 101; }
    if code == 14 { return length == 6 && src[start] == 97 && src[start+1] == 115 && src[start+2] == 115 && src[start+3] == 101 && src[start+4] == 114 && src[start+5] == 116; }
    if code == 15 { return length == 6 && src[start] == 105 && src[start+1] == 102 && src[start+2] == 122 && src[start+3] == 101 && src[start+4] == 114 && src[start+5] == 111; }
    if code == 16 { return length == 3 && src[start] == 101 && src[start+1] == 110 && src[start+2] == 100; }
    if code == 17 { return length == 4 && src[start] == 98 && src[start+1] == 108 && src[start+2] == 101 && src[start+3] == 110; }
    if code == 18 { return length == 4 && src[start] == 98 && src[start+1] == 103 && src[start+2] == 101 && src[start+3] == 116; }
    if code == 19 { return length == 4 && src[start] == 98 && src[start+1] == 115 && src[start+2] == 101 && src[start+3] == 116; }
    if code == 20 { return length == 6 && src[start] == 98 && src[start+1] == 119 && src[start+2] == 114 && src[start+3] == 105 && src[start+4] == 116 && src[start+5] == 101; }
    return false;
}

fn a_repeat_token(src: slice_i64, start: i64, length: i64) -> AParseInt {
    if length <= 7 { return AParseInt{ok: false, value: 0}; }
    if src[start] != 114 || src[start+1] != 101 || src[start+2] != 112 || src[start+3] != 101 || src[start+4] != 97 || src[start+5] != 116 || src[start+6] != 58 {
        return AParseInt{ok: false, value: 0};
    }
    return a_parse_u32(src, start + 7, length - 7, 1000000);
}

fn a_token_op(src: slice_i64, start: i64, length: i64) -> i64 {
    if length == 1 && src[start] == 43 { return A_ADD; }
    if length == 1 && src[start] == 45 { return A_SUB; }
    if length == 1 && src[start] == 42 { return A_MUL; }
    if length == 1 && src[start] == 47 { return A_DIV; }
    if length == 1 && src[start] == 37 { return A_MOD; }
    if a_eq(src,start,length,1) { return A_DUP; }
    if a_eq(src,start,length,2) { return A_DROP; }
    if a_eq(src,start,length,3) { return A_SWAP; }
    if a_eq(src,start,length,4) { return A_PRINT; }
    if a_eq(src,start,length,5) { return A_NEG; }
    if a_eq(src,start,length,6) { return A_HALT; }
    if a_eq(src,start,length,7) { return A_EQ; }
    if a_eq(src,start,length,8) { return A_LT; }
    if a_eq(src,start,length,9) { return A_LE; }
    if a_eq(src,start,length,10) { return A_ALLOC; }
    if a_eq(src,start,length,11) { return A_MGET; }
    if a_eq(src,start,length,12) { return A_MSET; }
    if a_eq(src,start,length,13) { return A_FREE; }
    if a_eq(src,start,length,14) { return A_ASSERT; }
    if a_eq(src,start,length,15) { return A_IFZERO; }
    if a_eq(src,start,length,17) { return A_BLEN; }
    if a_eq(src,start,length,18) { return A_BGET; }
    if a_eq(src,start,length,19) { return A_BSET; }
    if a_eq(src,start,length,20) { return A_BWRITE; }
    return -1;
}

fn a_store32(out: slice_i64, offset: i64, value: i64) -> void {
    let v: i64 = value;
    out[offset] = v % 256; v = v / 256;
    out[offset+1] = v % 256; v = v / 256;
    out[offset+2] = v % 256; v = v / 256;
    out[offset+3] = v % 256;
}

fn a_load32(data: slice_i64, offset: i64) -> i64 {
    return data[offset] + data[offset+1]*256 + data[offset+2]*65536 + data[offset+3]*16777216;
}

fn a_adler(data: slice_i64, start: i64, length: i64) -> i64 {
    let a: i64 = 1;
    let b: i64 = 0;
    let i: i64 = 0;
    while i < length {
        a = (a + data[start+i]) % 65521;
        b = (b + a) % 65521;
        i = i + 1;
    }
    return b*65536+a;
}

fn a_trace(trace: i64, value: i64) -> i64 {
    let m: i64 = value % 251;
    if m < 0 { m = m + 251; }
    return (trace*257 + m + 1) % 2147483629;
}

fn a_emit_header(out: slice_i64) -> i64 {
    let i: i64 = 0;
    while i < A_HEADER { out[i] = 0; i = i + 1; }
    out[0]=68; out[1]=88; out[2]=66; out[3]=51; out[4]=3; out[36]=1;
    return A_HEADER;
}

fn a_emit_push(out: slice_i64, pos: i64, value: i64) -> i64 {
    let u: i64 = value + 2147483648;
    out[pos] = A_PUSH;
    a_store32(out,pos+1,u);
    return pos+5;
}

fn a_analysis_error(code: i64) -> AAnalysis {
    return AAnalysis{ok:false,error:code,depth:0,max_depth:0,steps:0,caps:0,halted:false};
}

fn a_verify_range(code: slice_i64, start: i64, finish: i64, input_depth: i64, nesting: i64, top: bool) -> AAnalysis {
    if nesting > A_MAX_NESTING { return a_analysis_error(31); }
    let pc: i64 = start;
    let depth: i64 = input_depth;
    let max_depth: i64 = input_depth;
    let steps: i64 = 0;
    let caps: i64 = 0;
    let halted: bool = false;
    let ok: bool = true;
    let error: i64 = 0;
    while pc < finish && ok && !halted {
        let at: i64 = pc;
        let op: i64 = code[pc];
        pc = pc + 1;
        if steps >= A_MAX_STEPS { ok=false; error=30; }
        else { steps = steps + 1; }
        if ok {
            if op == A_HALT {
                if !top || pc != finish { ok=false; error=32; }
                else { halted=true; }
            } else if op == A_PUSH {
                if pc + 4 > finish { ok=false; error=33; }
                else { pc=pc+4; depth=depth+1; }
            } else if op == A_BYTES {
                if pc + 4 > finish { ok=false; error=56; }
                else {
                    let amount: i64 = a_load32(code,pc);
                    pc=pc+4;
                    if amount <= 0 || amount > A_MAX_HEAP { ok=false; error=57; }
                    else if pc + amount > finish { ok=false; error=58; }
                    else { pc=pc+amount; depth=depth+1; }
                }
            } else if op == A_ADD || op == A_SUB || op == A_MUL || op == A_DIV || op == A_MOD || op == A_EQ || op == A_LT || op == A_LE {
                if depth < 2 { ok=false; error=34; }
                else { depth=depth-1; }
            } else if op == A_DUP {
                if depth < 1 { ok=false; error=35; }
                else { depth=depth+1; }
            } else if op == A_DROP || op == A_NEG || op == A_ASSERT {
                if depth < 1 { ok=false; error=36; }
                else if op == A_DROP || op == A_ASSERT { depth=depth-1; }
            } else if op == A_SWAP {
                if depth < 2 { ok=false; error=37; }
            } else if op == A_PRINT {
                if depth < 1 { ok=false; error=38; }
                else { depth=depth-1; caps=a_caps_add(caps,A_CAP_PRINT_I64); }
            } else if op == A_BLEN {
                if depth < 1 { ok=false; error=121; }
                else { depth=depth+1; }
            } else if op == A_BGET {
                if depth < 2 { ok=false; error=122; }
            } else if op == A_BSET {
                if depth < 3 { ok=false; error=123; }
                else { depth=depth-2; }
            } else if op == A_BWRITE {
                if depth < 1 { ok=false; error=124; }
                else { caps=a_caps_add(caps,A_CAP_WRITE_BYTES); }
            } else if op == A_ALLOC {
                if depth < 1 { ok=false; error=39; }
            } else if op == A_MGET {
                if depth < 2 { ok=false; error=40; }
                else { depth=depth-1; }
            } else if op == A_MSET {
                if depth < 3 { ok=false; error=41; }
                else { depth=depth-2; }
            } else if op == A_FREE {
                if depth < 1 { ok=false; error=42; }
                else { depth=depth-1; }
            } else if op == A_REPEAT {
                if pc + 8 > finish { ok=false; error=43; }
                else {
                    let count: i64 = a_load32(code,pc);
                    let body_len: i64 = a_load32(code,pc+4);
                    pc=pc+8;
                    if count > 1000000 { ok=false; error=44; }
                    else if body_len < 0 || pc + body_len > finish { ok=false; error=45; }
                    else {
                        let body: AAnalysis = a_verify_range(code,pc,pc+body_len,depth,nesting+1,false);
                        if !body.ok { ok=false; error=body.error; }
                        else if body.depth != depth { ok=false; error=46; }
                        else if count != 0 && body.steps > A_MAX_STEPS / count { ok=false; error=47; }
                        else if steps > A_MAX_STEPS - body.steps*count { ok=false; error=30; }
                        else {
                            steps=steps+body.steps*count;
                            if body.max_depth > max_depth { max_depth=body.max_depth; }
                            caps=a_caps_add(caps,body.caps);
                            pc=pc+body_len;
                        }
                    }
                }
            } else if op == A_IFZERO {
                if depth < 1 { ok=false; error=48; }
                else if pc + 4 > finish { ok=false; error=49; }
                else {
                    let body_len: i64 = a_load32(code,pc);
                    pc=pc+4;
                    depth=depth-1;
                    if body_len < 0 || pc + body_len > finish { ok=false; error=50; }
                    else {
                        let body: AAnalysis = a_verify_range(code,pc,pc+body_len,depth,nesting+1,false);
                        if !body.ok { ok=false; error=body.error; }
                        else if body.depth != depth { ok=false; error=51; }
                        else if steps > A_MAX_STEPS - body.steps { ok=false; error=30; }
                        else {
                            steps=steps+body.steps;
                            if body.max_depth > max_depth { max_depth=body.max_depth; }
                            caps=a_caps_add(caps,body.caps);
                            pc=pc+body_len;
                        }
                    }
                }
            } else { ok=false; error=52; }
        }
        if ok && depth > A_MAX_STACK { ok=false; error=53; }
        if depth > max_depth { max_depth=depth; }
        if at < 0 { ok=false; error=99; }
    }
    if ok && top && !halted { ok=false; error=54; }
    if ok && !top && halted { ok=false; error=55; }
    return AAnalysis{ok:ok,error:error,depth:depth,max_depth:max_depth,steps:steps,caps:caps,halted:halted};
}

fn a_header_valid(code: slice_i64) -> bool {
    if array_len(code) < A_HEADER || array_len(code) > 67108864 { return false; }
    if code[0]!=68 || code[1]!=88 || code[2]!=66 || code[3]!=51 { return false; }
    if code[4]!=3 || code[5]!=0 || code[6]!=0 || code[7]!=0 { return false; }
    if a_load32(code,36) != A_POLICY { return false; }
    let payload: i64 = a_load32(code,8);
    if payload != array_len(code)-A_HEADER { return false; }
    if a_load32(code,12) != a_adler(code,A_HEADER,payload) { return false; }
    let heap: i64 = a_load32(code,28);
    return heap > 0 && heap <= A_MAX_HEAP;
}

fn a_verify(code: slice_i64) -> AAnalysis {
    if !a_header_valid(code) { return a_analysis_error(60); }
    let result: AAnalysis = a_verify_range(code,A_HEADER,array_len(code),0,0,true);
    if !result.ok { return result; }
    if a_load32(code,16) != result.caps { return a_analysis_error(67); }
    if a_load32(code,20) != result.max_depth { return a_analysis_error(68); }
    if a_load32(code,24) != result.steps { return a_analysis_error(69); }
    return result;
}

fn a_finalize(out: slice_i64, used: i64, src: slice_i64) -> result_i64 {
    if used < A_HEADER || used > 67108864 { return err_i64(as(i32,70)); }
    a_store32(out,8,used-A_HEADER);
    a_store32(out,12,a_adler(out,A_HEADER,used-A_HEADER));
    a_store32(out,28,A_MAX_HEAP);
    a_store32(out,32,a_adler(src,0,array_len(src)));
    a_store32(out,36,A_POLICY);
    let a: AAnalysis = a_verify_range(out,A_HEADER,used,0,0,true);
    let rc: result_i64 = ok_i64(used);
    if !a.ok { rc=err_i64(as(i32,a.error)); }
    else {
        a_store32(out,16,a.caps);
        a_store32(out,20,a.max_depth);
        a_store32(out,24,a.steps);
    }
    return rc;
}

fn a_emit_op(out: slice_i64, pos: i64, op: i64) -> i64 {
    out[pos]=op;
    return pos+1;
}

fn a_asm_eq(src: slice_i64, start: i64, length: i64, op: i64) -> bool {
    if op==A_ADD { return length==3&&src[start]==65&&src[start+1]==68&&src[start+2]==68; }
    if op==A_SUB { return length==3&&src[start]==83&&src[start+1]==85&&src[start+2]==66; }
    if op==A_MUL { return length==3&&src[start]==77&&src[start+1]==85&&src[start+2]==76; }
    if op==A_DIV { return length==3&&src[start]==68&&src[start+1]==73&&src[start+2]==86; }
    if op==A_MOD { return length==3&&src[start]==77&&src[start+1]==79&&src[start+2]==68; }
    if op==A_DUP { return length==3&&src[start]==68&&src[start+1]==85&&src[start+2]==80; }
    if op==A_DROP { return length==4&&src[start]==68&&src[start+1]==82&&src[start+2]==79&&src[start+3]==80; }
    if op==A_SWAP { return length==4&&src[start]==83&&src[start+1]==87&&src[start+2]==65&&src[start+3]==80; }
    if op==A_PRINT { return length==5&&src[start]==80&&src[start+1]==82&&src[start+2]==73&&src[start+3]==78&&src[start+4]==84; }
    if op==A_NEG { return length==3&&src[start]==78&&src[start+1]==69&&src[start+2]==71; }
    if op==A_EQ { return length==2&&src[start]==69&&src[start+1]==81; }
    if op==A_LT { return length==2&&src[start]==76&&src[start+1]==84; }
    if op==A_LE { return length==2&&src[start]==76&&src[start+1]==69; }
    if op==A_ALLOC { return length==5&&src[start]==65&&src[start+1]==76&&src[start+2]==76&&src[start+3]==79&&src[start+4]==67; }
    if op==A_MGET { return length==4&&src[start]==77&&src[start+1]==71&&src[start+2]==69&&src[start+3]==84; }
    if op==A_MSET { return length==4&&src[start]==77&&src[start+1]==83&&src[start+2]==69&&src[start+3]==84; }
    if op==A_FREE { return length==4&&src[start]==70&&src[start+1]==82&&src[start+2]==69&&src[start+3]==69; }
    if op==A_ASSERT { return length==6&&src[start]==65&&src[start+1]==83&&src[start+2]==83&&src[start+3]==69&&src[start+4]==82&&src[start+5]==84; }
    if op==A_BLEN { return length==4&&src[start]==66&&src[start+1]==76&&src[start+2]==69&&src[start+3]==78; }
    if op==A_BGET { return length==4&&src[start]==66&&src[start+1]==71&&src[start+2]==69&&src[start+3]==84; }
    if op==A_BSET { return length==4&&src[start]==66&&src[start+1]==83&&src[start+2]==69&&src[start+3]==84; }
    if op==A_BWRITE { return length==6&&src[start]==66&&src[start+1]==87&&src[start+2]==82&&src[start+3]==73&&src[start+4]==84&&src[start+5]==69; }
    if op==A_HALT { return length==4&&src[start]==72&&src[start+1]==65&&src[start+2]==76&&src[start+3]==84; }
    return false;
}

fn a_asm_op(src: slice_i64, start: i64, length: i64) -> i64 {
    let op: i64=0;
    while op<=A_BWRITE {
        if a_asm_eq(src,start,length,op) { return op; }
        op=op+1;
    }
    return -1;
}

fn a_word_upper(src: slice_i64, start: i64, length: i64, code: i64) -> bool {
    if code==1 { return length==4&&src[start]==80&&src[start+1]==85&&src[start+2]==83&&src[start+3]==72; }
    if code==2 { return length==6&&src[start]==82&&src[start+1]==69&&src[start+2]==80&&src[start+3]==69&&src[start+4]==65&&src[start+5]==84; }
    if code==3 { return length==6&&src[start]==73&&src[start+1]==70&&src[start+2]==90&&src[start+3]==69&&src[start+4]==82&&src[start+5]==79; }
    if code==4 { return length==3&&src[start]==69&&src[start+1]==78&&src[start+2]==68; }
    return false;
}
