enum Mode { Fast, Safe, Debug }

struct Point {
    x: i64,
    y: i64,
    mode: Mode,
}

fn sum_slice(values: slice_i64) -> i64 {
    let i: i64 = 0;
    let total: i64 = 0;
    while i < array_len(values) {
        total = total + values[i];
        i = i + 1;
    }
    return total;
}

fn maybe_value(ok: bool) -> result_i64 {
    if ok {
        return ok_i64(99);
    } else {
        return err_i64(as(i32, 7));
    }
}

fn main() -> i32 {
    let p: Point = Point{x: 3, y: 4, mode: Mode.Safe};
    assert(p.x + p.y == 7);
    let data: array_i64 = array_new(4, 1);
    data[2] = 5;
    let view: slice_i64 = slice(data, 1, 3);
    let total: i64 = sum_slice(view);
    print_i64(total);
    let r: result_i64 = maybe_value(true);
    print_i64(unwrap_i64(r));
    array_free(data);
    return as(i32, 0);
}
