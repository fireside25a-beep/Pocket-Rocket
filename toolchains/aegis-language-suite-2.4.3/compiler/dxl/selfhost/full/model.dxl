// DXL-authored integrated frontend foundation.
//
// Storage is deliberately represented by bounded parallel slices. This keeps
// allocation explicit, makes capacity failures deterministic, and stays inside
// the verified DXL profile used to build the foundation.

const FULL_STATE_POS: i64 = 0;
const FULL_STATE_AST_COUNT: i64 = 1;
const FULL_STATE_DIAG_COUNT: i64 = 2;
