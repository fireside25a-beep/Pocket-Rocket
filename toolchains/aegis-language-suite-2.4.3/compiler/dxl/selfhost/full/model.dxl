const FULL_TIR_BINARY: i64 = 25;

struct FullParseValue {
    ok: bool,
    node: i64,
}

struct FullParseReport {
    finished: bool,
    clean: bool,
    token_count: i64,
    ast_count: i64,
    diagnostic_count: i64,
    scope_count: i64,
}

struct FullSemanticReport {
    clean: bool,
    symbol_count: i64,
    diagnostic_count: i64,
    typed_count: i64,
}

struct FullLowerReport {
    clean: bool,
    instruction_count: i64,
    digest: i64,
}
