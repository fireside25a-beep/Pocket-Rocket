import "codes.dxl";

// Build the complete byte classifier and single-character token table once.
// Lexing then classifies every input byte with one indexed lookup.
fn byte_tables_init(classes: slice_i64, single_tokens: slice_i64) -> bool {
    if array_len(classes) < 256 || array_len(single_tokens) < 256 { return false; }
    let i: i64 = 0;
    while i < 256 { classes[i]=BC_OTHER;single_tokens[i]=-1;i=i+1; }

    classes[9]=BC_SPACE;classes[10]=BC_SPACE;classes[11]=BC_SPACE;classes[12]=BC_SPACE;classes[13]=BC_SPACE;classes[32]=BC_SPACE;
    i=48;while i<=57 { classes[i]=BC_DIGIT;i=i+1; }
    i=65;while i<=90 { classes[i]=BC_IDENT;i=i+1; }
    i=97;while i<=122 { classes[i]=BC_IDENT;i=i+1; }
    classes[95]=BC_IDENT;
    classes[34]=BC_QUOTE;
    classes[47]=BC_SLASH;

    single_tokens[40]=TK_LPAREN;single_tokens[41]=TK_RPAREN;
    single_tokens[123]=TK_LBRACE;single_tokens[125]=TK_RBRACE;
    single_tokens[91]=TK_LBRACKET;single_tokens[93]=TK_RBRACKET;
    single_tokens[58]=TK_COLON;single_tokens[59]=TK_SEMI;
    single_tokens[44]=TK_COMMA;single_tokens[46]=TK_DOT;
    single_tokens[61]=TK_ASSIGN;single_tokens[43]=TK_PLUS;
    single_tokens[45]=TK_MINUS;single_tokens[42]=TK_STAR;
    single_tokens[47]=TK_SLASH;single_tokens[37]=TK_PERCENT;
    single_tokens[60]=TK_LT;single_tokens[62]=TK_GT;
    single_tokens[33]=TK_BANG;

    i=0;
    while i<256 {
        if single_tokens[i]>=0 { classes[i]=BC_SYMBOL; }
        i=i+1;
    }
    classes[47]=BC_SLASH;
    classes[38]=BC_SYMBOL;
    classes[124]=BC_SYMBOL;
    return true;
}

// The keyword bytes are concatenated in strict lexical order. Recognition is
// a binary search over starts/lengths/kinds, never a per-keyword branch chain.
fn keyword_table_init(bytes: slice_i64, starts: slice_i64, lengths: slice_i64, kinds: slice_i64) -> bool {
    if array_len(bytes)<KEYWORD_BYTE_COUNT || array_len(starts)<KEYWORD_COUNT || array_len(lengths)<KEYWORD_COUNT || array_len(kinds)<KEYWORD_COUNT { return false; }

    starts[0]=0;lengths[0]=9;kinds[0]=TK_ARRAY_I64;
    starts[1]=9;lengths[1]=2;kinds[1]=TK_AS;
    starts[2]=11;lengths[2]=6;kinds[2]=TK_ASSERT;
    starts[3]=17;lengths[3]=4;kinds[3]=TK_BOOL;
    starts[4]=21;lengths[4]=8;kinds[4]=TK_COMPTIME;
    starts[5]=29;lengths[5]=5;kinds[5]=TK_CONST;
    starts[6]=34;lengths[6]=4;kinds[6]=TK_ELSE;
    starts[7]=38;lengths[7]=4;kinds[7]=TK_ENUM;
    starts[8]=42;lengths[8]=6;kinds[8]=TK_EXPORT;
    starts[9]=48;lengths[9]=6;kinds[9]=TK_EXTERN;
    starts[10]=54;lengths[10]=5;kinds[10]=TK_FALSE;
    starts[11]=59;lengths[11]=2;kinds[11]=TK_FN;
    starts[12]=61;lengths[12]=3;kinds[12]=TK_I32;
    starts[13]=64;lengths[13]=3;kinds[13]=TK_I64;
    starts[14]=67;lengths[14]=2;kinds[14]=TK_IF;
    starts[15]=69;lengths[15]=6;kinds[15]=TK_IMPORT;
    starts[16]=75;lengths[16]=3;kinds[16]=TK_LET;
    starts[17]=78;lengths[17]=10;kinds[17]=TK_RESULT_I64;
    starts[18]=88;lengths[18]=6;kinds[18]=TK_RETURN;
    starts[19]=94;lengths[19]=9;kinds[19]=TK_SLICE_I64;
    starts[20]=103;lengths[20]=6;kinds[20]=TK_STRUCT;
    starts[21]=109;lengths[21]=4;kinds[21]=TK_TEST;
    starts[22]=113;lengths[22]=4;kinds[22]=TK_TRUE;
    starts[23]=117;lengths[23]=4;kinds[23]=TK_VOID;
    starts[24]=121;lengths[24]=5;kinds[24]=TK_WHILE;

    bytes[0]=97;bytes[1]=114;bytes[2]=114;bytes[3]=97;bytes[4]=121;bytes[5]=95;bytes[6]=105;bytes[7]=54;bytes[8]=52;
    bytes[9]=97;bytes[10]=115;
    bytes[11]=97;bytes[12]=115;bytes[13]=115;bytes[14]=101;bytes[15]=114;bytes[16]=116;
    bytes[17]=98;bytes[18]=111;bytes[19]=111;bytes[20]=108;
    bytes[21]=99;bytes[22]=111;bytes[23]=109;bytes[24]=112;bytes[25]=116;bytes[26]=105;bytes[27]=109;bytes[28]=101;
    bytes[29]=99;bytes[30]=111;bytes[31]=110;bytes[32]=115;bytes[33]=116;
    bytes[34]=101;bytes[35]=108;bytes[36]=115;bytes[37]=101;
    bytes[38]=101;bytes[39]=110;bytes[40]=117;bytes[41]=109;
    bytes[42]=101;bytes[43]=120;bytes[44]=112;bytes[45]=111;bytes[46]=114;bytes[47]=116;
    bytes[48]=101;bytes[49]=120;bytes[50]=116;bytes[51]=101;bytes[52]=114;bytes[53]=110;
    bytes[54]=102;bytes[55]=97;bytes[56]=108;bytes[57]=115;bytes[58]=101;
    bytes[59]=102;bytes[60]=110;
    bytes[61]=105;bytes[62]=51;bytes[63]=50;
    bytes[64]=105;bytes[65]=54;bytes[66]=52;
    bytes[67]=105;bytes[68]=102;
    bytes[69]=105;bytes[70]=109;bytes[71]=112;bytes[72]=111;bytes[73]=114;bytes[74]=116;
    bytes[75]=108;bytes[76]=101;bytes[77]=116;
    bytes[78]=114;bytes[79]=101;bytes[80]=115;bytes[81]=117;bytes[82]=108;bytes[83]=116;bytes[84]=95;bytes[85]=105;bytes[86]=54;bytes[87]=52;
    bytes[88]=114;bytes[89]=101;bytes[90]=116;bytes[91]=117;bytes[92]=114;bytes[93]=110;
    bytes[94]=115;bytes[95]=108;bytes[96]=105;bytes[97]=99;bytes[98]=101;bytes[99]=95;bytes[100]=105;bytes[101]=54;bytes[102]=52;
    bytes[103]=115;bytes[104]=116;bytes[105]=114;bytes[106]=117;bytes[107]=99;bytes[108]=116;
    bytes[109]=116;bytes[110]=101;bytes[111]=115;bytes[112]=116;
    bytes[113]=116;bytes[114]=114;bytes[115]=117;bytes[116]=101;
    bytes[117]=118;bytes[118]=111;bytes[119]=105;bytes[120]=100;
    bytes[121]=119;bytes[122]=104;bytes[123]=105;bytes[124]=108;bytes[125]=101;
    return true;
}

fn keyword_compare(src: slice_i64, start: i64, length: i64, bytes: slice_i64, table_start: i64, table_length: i64) -> i64 {
    let limit: i64=length;
    if table_length<limit { limit=table_length; }
    let i: i64=0;
    let order: i64=0;
    while i<limit&&order==0 {
        if src[start+i]<bytes[table_start+i] { order=-1; }
        else if src[start+i]>bytes[table_start+i] { order=1; }
        i=i+1;
    }
    if order==0 {
        if length<table_length { order=-1; }
        else if length>table_length { order=1; }
    }
    return order;
}

fn keyword_lookup(src: slice_i64, start: i64, length: i64, bytes: slice_i64, starts: slice_i64, lengths: slice_i64, kinds: slice_i64) -> i64 {
    let low: i64=0;
    let high: i64=KEYWORD_COUNT;
    let found: i64=TK_IDENT;
    while low<high&&found==TK_IDENT {
        let middle: i64=(low+high)/2;
        let order: i64=keyword_compare(src,start,length,bytes,starts[middle],lengths[middle]);
        if order==0 { found=kinds[middle]; }
        else if order<0 { high=middle; }
        else { low=middle+1; }
    }
    return found;
}

