import "test_support.dxl";

fn main()->i32 {
    let owner:array_i64=array_new(13,0);
    let tokens:slice_i64=slice(owner,0,array_len(owner));
    tokens[0]=TK_CONST; tokens[1]=TK_IDENT; tokens[2]=TK_SEMI;
    tokens[3]=TK_FN; tokens[4]=TK_IDENT; tokens[5]=TK_LBRACE;
    tokens[6]=TK_LET; tokens[7]=TK_IDENT; tokens[8]=TK_SEMI;
    tokens[9]=TK_RETURN; tokens[10]=TK_SEMI; tokens[11]=TK_RBRACE; tokens[12]=TK_EOF;
    let report:FixtureReport=run_parser_fixture(tokens,13);
    assert(report.finished); assert(report.clean); assert(report.containment);
    assert(report.ast_count==5); assert(report.type_count==2); assert(report.diag_count==0);
    assert(report.progress_failures==0); assert(report.ast_digest==986115);
    print_i64(report.ast_count); print_i64(report.type_count); print_i64(report.diag_count);
    print_i64(report.ast_digest); print_bool(report.containment);
    array_free(owner); return as(i32,0);
}
